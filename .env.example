# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api
API_VERSION=1
FRONTEND_URL=http://localhost:3000

# CORS
# Comma-separated list or "*"
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE="FashionAI API"
SWAGGER_DESCRIPTION="API documentation for FashionAI."
SWAGGER_VERSION=1.0.0

# Rate limiting
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
GLOBAL_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10

# Database - Neon PostgreSQL
# Use pooled connection for runtime and direct connection for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT / Token
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_REFRESH_EXPIRES_IN=30d
MAINTENANCE_SECRET="change_me_maintenance_secret"

# Refresh token cookie
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api
# REFRESH_COOKIE_DOMAIN=.example.com
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false

# AI runtime & Models
AI_TRYON_PROVIDER=mock
MOCK_TRYON_RESULT_URL=
TIMEOUT_MS=120000
FASHN_MODEL="fashn/tryon-v1.6"
SAM2_MODEL="fal-ai/sam2/image"
FASHN_MODE="balanced"
GEMINI_MODEL="gemini-2.0-flash"

# fal.ai - Virtual Try-On
FAL_KEY="your_fal_api_key_here"
SAM2_ENABLED=true

# Google Gemini - AI Stylist
GEMINI_API_KEY="your_gemini_api_key_here"

# Redis - planned for quota/rate-limit/token blacklist
# Prefer REDIS_URL for hosted Redis providers such as Upstash.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail - planned for verify email / forgot password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=fashionai.system@gmail.com
MAIL_PASSWORD=usxk cyol jnal nozv
MAIL_FROM="FashionAI <noreply@fashionai.com>"

# Cloudinary / object storage - planned for product images and try-on results
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=fashionai
CLOUDINARY_MAX_FILE_SIZE=10485760

# Payment provider - PayOS / MoMo Sandbox
PAYMENT_DEFAULT_PROVIDER=MOMO
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/orders/success
PAYOS_CANCEL_URL=http://localhost:3000/checkout

# MoMo Sandbox Credentials (Default Test Account)
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF81
MOMO_SECRET_KEY=K951B6FA292D6C6F2B57B2F6A1715424D
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/orders/success
MOMO_IPN_URL=http://localhost:3000/api/payments/momo-ipn

# Google OAuth2 SSO - planned
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:3000/google/callback
GOOGLE_OAUTH_STATE_TTL=300
