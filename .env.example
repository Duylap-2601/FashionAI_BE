# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api
FRONTEND_URL=http://localhost:3000

# CORS
# Comma-separated list or "*"
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE="FashionAI API"
SWAGGER_DESCRIPTION="API documentation for FashionAI."
SWAGGER_VERSION=1.0.0

# Rate limiting
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
GLOBAL_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
# So reverse proxy dung truoc app, dung de suy ra IP client that tu X-Forwarded-For.
# Render/Vercel = 1. Dat 0 khi chay truc tiep (local, docker-compose khong co proxy).
# Dat sai qua cao = client tu bia IP duoc -> bypass rate limit.
TRUST_PROXY_HOPS=1

# Database - Neon PostgreSQL
# Use pooled connection for runtime and direct connection for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT / Token
# Bat buoc - app se dung ngay luc boot neu thieu. Sinh bang:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_REFRESH_EXPIRES_IN=30d
MAINTENANCE_SECRET="change_me_maintenance_secret"
# Dat false neu chay nhieu instance va chi muon mot worker chay cron don dep.
MAINTENANCE_CRON_ENABLED=true

# Seed (chi dung khi chay `npm run prisma:seed`, toi thieu 12 ky tu)
# Khong hardcode trong repo: moi truong nao da seed thi mat khau do la cong khai.
SEED_ADMIN_PASSWORD=""
SEED_DEMO_PASSWORD=""

# Refresh token cookie
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api
# REFRESH_COOKIE_DOMAIN=.example.com
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false

# AI runtime & Models
AI_TRYON_PROVIDER=mock
MOCK_TRYON_RESULT_URL=
TIMEOUT_MS=120000
FASHN_MODEL="fashn/tryon-v1.6"
SAM2_MODEL="fal-ai/sam2/image"
FASHN_MODE="balanced"
GEMINI_MODEL="gemini-2.0-flash"
# So ngay giu cache ket qua thu do truoc khi coi la het han.
TRYON_CACHE_TTL_DAYS=30
# Bat cong kiem tra chat luong anh bang Gemini truoc khi goi fal.ai (tranh ton phi
# voi anh mo/thieu nguoi). Can GEMINI_API_KEY. Mac dinh tat.
TRYON_QUALITY_GATE_ENABLED=false

# So ngay giu cache ket qua AI Stylist truoc khi coi la het han.
STYLIST_CACHE_TTL_DAYS=30



# fal.ai - Virtual Try-On
FAL_KEY="your_fal_api_key_here"
SAM2_ENABLED=true

# Google Gemini - AI Stylist
GEMINI_API_KEY="your_gemini_api_key_here"

# Groq - Chatbot
# Get API key from: https://console.groq.com/keys
# Current recommended models (as of 2026-08):
#   - openai/gpt-oss-120b (best quality, replaces llama-3.3-70b)
#   - qwen/qwen3.6-27b (alternative)
#   - openai/gpt-oss-20b (replaces llama-3.1-8b)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=2048

# Redis - planned for quota/rate-limit/token blacklist
# Prefer REDIS_URL for hosted Redis providers such as Upstash.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail - Brevo (Sendinblue) Transactional Email API
# Get API key from: https://app.brevo.com/settings/keys
BREVO_API_KEY="your_brevo_api_key_here"
MAIL_FROM="FashionAI <noreply@yourdomain.com>"

# Cloudinary / object storage - planned for product images and try-on results
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=fashionai

# Payment: SePay la cong thanh toan duy nhat.
# Base URL dung cho link mock-success khi chua cau hinh cong thanh toan (chi ngoai production).
PAYMENT_MOCK_BASE_URL=http://localhost:3000/api

# SePay Payment Gateway
SEPAY_MERCHANT_ID="your_sepay_merchant_id"
SEPAY_SECRET_KEY="your_sepay_checkout_secret_key"
SEPAY_IPN_SECRET="your_sepay_ipn_hmac_secret_key"
SEPAY_WEBHOOK_SECRET="your_sepay_webhook_hmac_secret_key"
SEPAY_IPN_TIMESTAMP_TOLERANCE_SECONDS=300
SEPAY_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
SEPAY_CHECKOUT_URL=https://pay-sandbox.sepay.vn/v1/checkout/init
SEPAY_SUCCESS_URL=http://localhost:3000/orders/success
SEPAY_ERROR_URL=http://localhost:3000/checkout/error
SEPAY_CANCEL_URL=http://localhost:3000/checkout

# Google OAuth2 SSO - planned
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:3000/google/callback
GOOGLE_OAUTH_STATE_TTL=300

# Blender Avatar pipeline (Phase 4 - 3D Mannequin) - OPTIONAL
# Chi can cau hinh neu muon bat tinh nang Tao Avatar 3D tu so do.
# Yeu cau: cai Blender (4.x/5.x) + MPFB2 addon (>= 2.0.0). Neu muon dung BLENDER_PATH
# tren he dieu hanh khac (macOS: /Applications/Blender.app/Contents/MacOS/Blender, Linux:
# /usr/bin/blender), hoac them thu muc chua blender vao PATH va de TRONG.
# De trong -> dich vu dung lenh `blender` tu PATH. Khong cai Blender -> chi rieng cac
# endpoint /api/avatar tra 503, toan bo app van chay binh thuong.
BLENDER_PATH=
# Duong dan script generator (mac dinh: src/modules/avatar/blender/generate_avatar.py)
# AVATAR_SCRIPT_PATH=
# Thu muc luu GLB khi chua cau hinh Cloudinary (fallback).
AVATAR_STORAGE_DIR=storage/avatars
# Base URL dung de tao glbUrl khi luu local: {base}/{fileName}/file
AVATAR_PUBLIC_BASE_URL=http://localhost:3001/api/avatar
# Thoi gian cho Blender toi da (ms) truoc khi tra 503.
AVATAR_TIMEOUT_MS=60000
