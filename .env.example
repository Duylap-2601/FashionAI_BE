# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api
FRONTEND_URL=http://localhost:3000
SERVICE_NAME=fashionai-be
APP_VERSION=1.0.0
API_VERSION=1.0.0

# Logging
LOG_LEVEL=debug
# Pretty logs are for local development only. Production should keep JSON stdout.
LOG_PRETTY=true

# CORS
# Comma-separated list or "*"
CORS_ORIGINS=http://localhost:3000
# Legacy/single-origin name kept for deployments that still use it.
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE="StAle API"
SWAGGER_DESCRIPTION="API documentation for StAle."
SWAGGER_VERSION=1.0.0

# Rate limiting
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
GLOBAL_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
# So reverse proxy dung truoc app, dung de suy ra IP client that tu X-Forwarded-For.
# Render/Vercel = 1. Dat 0 khi chay truc tiep (local, docker-compose khong co proxy).
# Dat sai qua cao = client tu bia IP duoc -> bypass rate limit.
TRUST_PROXY_HOPS=1

# Database - Neon PostgreSQL
# Use pooled connection for runtime and direct connection for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Optional old database URLs kept only for manual rollback/reference. App should use DATABASE_URL and DIRECT_URL.
DATABASE_URL_OLD=
DIRECT_URL_OLD=

# Render + Tailscale private PostgreSQL
# Keep false for local Docker Compose or any environment that can reach DATABASE_URL directly.
# When true, DATABASE_URL and DIRECT_URL should point to the local proxy below.
TAILSCALE_ENABLED=false
# Store the auth key only in Render secrets. Use a reusable + ephemeral + pre-approved key when required by tailnet policy.
TS_AUTHKEY=
TAILSCALE_HOSTNAME=fashionai-be-render
TAILSCALE_DB_HOST=100.90.252.117
TAILSCALE_DB_PORT=30432
DB_PROXY_PORT=15432
# Optional Redis proxy through the same Tailscale node. When set, point
# REDIS_URL to redis://USER:PASSWORD@127.0.0.1:${REDIS_PROXY_PORT}/DB.
TAILSCALE_REDIS_HOST=100.90.252.117
TAILSCALE_REDIS_PORT=30379
REDIS_PROXY_PORT=16379
TAILSCALE_STARTUP_TIMEOUT_SECONDS=60
DB_CONNECT_TIMEOUT_SECONDS=60
# Example for Render Tailscale mode. URL-encode special characters in the password.
# DATABASE_URL="postgresql://lamtailoi:URL_ENCODED_PASSWORD@127.0.0.1:15432/lamtailoi"
# DIRECT_URL="postgresql://lamtailoi:URL_ENCODED_PASSWORD@127.0.0.1:15432/lamtailoi"

# JWT / Token
# Bat buoc - app se dung ngay luc boot neu thieu. Sinh bang:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_REFRESH_EXPIRES_IN=30d
MAINTENANCE_SECRET="change_me_maintenance_secret"
# Dat false neu chay nhieu instance va chi muon mot worker chay cron don dep.
MAINTENANCE_CRON_ENABLED=true
# Base URL public cua service (Render), dung de cron keep-alive tu ping
# GET /health/liveness moi 10 phut, tranh Render free tier bi sleep vi cold start.
PUBLIC_API_URL=https://your-service.onrender.com

# Seed (chi dung khi chay `npm run prisma:seed`, toi thieu 12 ky tu)
# Khong hardcode trong repo: moi truong nao da seed thi mat khau do la cong khai.
SEED_ADMIN_PASSWORD=""
SEED_DEMO_PASSWORD=""

# Refresh token cookie
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api
# REFRESH_COOKIE_DOMAIN=.example.com
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false

# AI runtime & Models
AI_TRYON_PROVIDER=mock
MOCK_TRYON_RESULT_URL=
TIMEOUT_MS=120000
# Model name for FASHN API: "tryon-v1.6" or "tryon-max"
FASHN_MODEL="tryon-v1.6"
FASHN_MODE="balanced"
GEMINI_MODEL="gemini-2.0-flash"
# So ngay giu cache ket qua thu do truoc khi coi la het han.
TRYON_CACHE_TTL_DAYS=30
# Bat cong kiem tra chat luong anh bang Gemini truoc khi goi FASHN API (tranh ton credit
# voi anh mo/thieu nguoi). Can GEMINI_API_KEY. Mac dinh tat.
TRYON_QUALITY_GATE_ENABLED=false

# So ngay giu cache ket qua AI Stylist truoc khi coi la het han.
STYLIST_CACHE_TTL_DAYS=30



# FASHN API - Virtual Try-On (https://app.fashn.ai)
# Get API key from: https://app.fashn.ai/api
FASHN_API_KEY="your_fashn_api_key_here"

# Decart Lucy - Live Try-On
# Keep this key server-side only. Do not expose it through NEXT_PUBLIC_* env vars.
DECART_API_KEY="your_decart_api_key_here"
DECART_CLIENT_TOKEN_ENDPOINT=https://api.decart.ai/v1/client/tokens
DECART_CLIENT_TOKEN_TIMEOUT_MS=10000
DECART_LIVE_TRYON_ENABLED=false
DECART_LIVE_TRYON_PROVIDER=decart
DECART_LIVE_MODEL=lucy-vton-3.5
DECART_LIVE_TOKEN_TTL_SECONDS=120
DECART_LIVE_MAX_DURATION_SECONDS=60
DECART_LIVE_GRACE_SECONDS=30
DECART_LIVE_CLIENT_END_GRACE_SECONDS=15
DECART_LIVE_USER_DAILY_SECONDS=300
DECART_LIVE_GLOBAL_DAILY_CREDITS=12000
DECART_LIVE_MAX_CONCURRENT_SESSIONS=5
DECART_LIVE_DB_RETRY_ATTEMPTS=3
DECART_LIVE_RATE_CREDITS_PER_SECOND=2
DECART_LIVE_GARMENT_FETCH_TIMEOUT_MS=10000
DECART_LIVE_GARMENT_MAX_BYTES=8388608
DECART_LIVE_POLICY_VERSION=live-v1
# Empty allowlists mean all eligible paid users/products are allowed after feature flag is enabled.
DECART_LIVE_BETA_USER_IDS=
DECART_LIVE_BETA_PRODUCT_IDS=
DECART_LIVE_ALLOWED_CATEGORIES=UPPER,LOWER,FULL_BODY

# Google Gemini - AI Stylist
GEMINI_API_KEY="your_gemini_api_key_here"

# Groq - Chatbot
# Get API key from: https://console.groq.com/keys
# Current recommended models (as of 2026-08):
#   - openai/gpt-oss-120b (best quality, replaces llama-3.3-70b)
#   - qwen/qwen3.6-27b (alternative)
#   - openai/gpt-oss-20b (replaces llama-3.1-8b)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=2048

# Redis - planned for quota/rate-limit/token blacklist
# Prefer REDIS_URL for hosted Redis providers such as Upstash.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Example for Render Tailscale Redis mode.
# REDIS_URL=redis://lamtailoi:@127.0.0.1:16379/1

# Legacy throttler names, if an older deployment still reads them.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Mail - Brevo (Sendinblue) Transactional Email API
# Get API key from: https://app.brevo.com/settings/keys
BREVO_API_KEY="your_brevo_api_key_here"
MAIL_FROM="StAle <noreply@yourdomain.com>"
# Legacy SMTP fallback settings. Prefer Brevo API unless code path explicitly needs SMTP.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# Cloudinary / object storage - planned for product images and try-on results
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=fashionai
CLOUDINARY_MAX_FILE_SIZE=10485760

# Shipping: GHN
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=
GHN_WEBHOOK_SECRET=
# Fallback pickup origin. Runtime admin settings should override these when configured.
GHN_FROM_PROVINCE_ID=
GHN_FROM_DISTRICT_ID=
GHN_FROM_WARD_CODE=

# Payment: SePay la cong thanh toan duy nhat.
# Base URL dung cho link mock-success khi chua cau hinh cong thanh toan (chi ngoai production).
PAYMENT_MOCK_BASE_URL=http://localhost:3000/api
PAYMENT_DEFAULT_PROVIDER=SEPAY
PAYMENT_ALLOW_MOCK_FALLBACK=false

# SePay Payment Gateway
SEPAY_MERCHANT_ID="your_sepay_merchant_id"
SEPAY_SECRET_KEY="your_sepay_checkout_secret_key"
SEPAY_IPN_SECRET="your_sepay_ipn_hmac_secret_key"
SEPAY_WEBHOOK_SECRET="your_sepay_webhook_hmac_secret_key"
SEPAY_WEBHOOK_VERIFY_HMAC=true
SEPAY_IPN_TIMESTAMP_TOLERANCE_SECONDS=300
SEPAY_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
SEPAY_CHECKOUT_URL=https://pay-sandbox.sepay.vn/v1/checkout/init
SEPAY_SUCCESS_URL=http://localhost:3000/orders/success
SEPAY_ERROR_URL=http://localhost:3000/checkout/error
SEPAY_CANCEL_URL=http://localhost:3000/checkout

# MoMo legacy/optional payment provider settings.
MOMO_ENV=sandbox
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_PARTNER_NAME=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_STORE_ID=
MOMO_ORDER_GROUP_ID=
MOMO_REDIRECT_URL=http://localhost:3000/payment/momo/return
MOMO_IPN_URL=http://localhost:3001/api/payments/momo/ipn
MOMO_REQUEST_TYPE=captureWallet
MOMO_AUTO_CAPTURE=true
MOMO_LANG=vi

# ZaloPay legacy/optional payment provider settings.
ZALOPAY_ENV=sandbox
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CALLBACK_URL=http://localhost:3001/api/payments/zalopay/callback
ZALOPAY_REDIRECT_URL=http://localhost:3000/payment/zalopay/return

# Google OAuth2 SSO - planned
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:3000/google/callback
GOOGLE_OAUTH_STATE_TTL=300

# Cross-Platform Auth - Mobile OAuth
# Deep link URL cho mobile Google OAuth callback. App phải register scheme này.
# Ưu tiên App Links / Universal Links (https://) hơn custom scheme trên production.
MOBILE_GOOGLE_CALLBACK_URL=fashionai://auth
