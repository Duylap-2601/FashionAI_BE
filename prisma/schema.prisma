datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  // Alpine không có binary `openssl` nên Prisma tự đoán sai thành openssl-1.1.x và
  // sinh engine link tới libssl.so.1.1 (không tồn tại trong image). Khai báo tay
  // để engine luôn khớp libssl.so.3.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum UserTier {
  FREE
  MEMBER
  VIP
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum GarmentCategory {
  UPPER
  LOWER
  FULL_BODY
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
  RETURNED
  EXPIRED
  FAILED
}

enum AiActionType {
  TRY_ON
  STYLIST
  CHATBOT
}

enum NotificationType {
  ORDER_STATUS
  PAYMENT
  PROMOTION
  SYSTEM
  REVIEW
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique
  passwordHash  String?      @map("password_hash")
  name          String?
  avatarUrl     String?      @map("avatar_url")
  provider      AuthProvider @default(LOCAL)
  providerId    String?      @map("provider_id")
  tier          UserTier     @default(FREE)
  tierExpiresAt DateTime?    @map("tier_expires_at")
  role          Role         @default(USER)
  isVerified    Boolean      @default(false) @map("is_verified")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  measurements            Measurement?
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  tryOnResults            TryOnResult[]
  stylistResults          StylistResult[]
  orders                  Order[]
  dailyUsages             DailyUsage[]
  chatSessions            ChatSession[]
  notifications           Notification[]
  subscriptions           Subscription[]
  rackItems               RackItem[]
  reviews                 Review[]
  reviewReplies           ReviewReply[]

  @@map("users")
}

model Measurement {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  height       Decimal? @db.Decimal(5, 1)
  weight       Decimal? @db.Decimal(5, 1)
  chest        Decimal? @db.Decimal(5, 1)
  waist        Decimal? @db.Decimal(5, 1)
  hip          Decimal? @db.Decimal(5, 1)
  shoulder     Decimal? @db.Decimal(5, 1)
  neck         Decimal? @db.Decimal(5, 1)
  sleeveLength Decimal? @map("sleeve_length") @db.Decimal(5, 1)
  wrist        Decimal? @db.Decimal(5, 1)
  thigh        Decimal? @db.Decimal(5, 1)
  knee         Decimal? @db.Decimal(5, 1)
  calf         Decimal? @db.Decimal(5, 1)
  inseam       Decimal? @db.Decimal(5, 1)
  outseam      Decimal? @db.Decimal(5, 1)
  shirtLength  Decimal? @map("shirt_length") @db.Decimal(5, 1)
  underbust    Decimal? @db.Decimal(5, 1)
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("measurements")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Product {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  description   String?         @db.Text
  category      GarmentCategory @default(UPPER)
  color         String?
  price         Decimal         @db.Decimal(10, 2)
  originalPrice Decimal?        @map("original_price") @db.Decimal(10, 2)
  stock         Int             @default(0)
  brand         String?         @default("StAle. SIGNATURE")
  garmentUrl    String          @map("garment_url")
  status        ProductStatus   @default(ACTIVE)
  colors        Json? // [{ name: string, hex: string }]
  material      String?
  avgRating     Decimal?        @default(0) @db.Decimal(2, 1) @map("avg_rating")
  reviewCount   Int             @default(0) @map("review_count")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  images         ProductImage[]
  tryOnResults   TryOnResult[]
  stylistResults StylistResult[]
  orderItems     OrderItem[]
  rackItems      RackItem[]
  reviews        Review[]

  @@map("products")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  rating    Int
  comment   String?  @db.Text
  images    Json?    // [{ url: string }]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  replies ReviewReply[]

  @@unique([userId, productId, orderId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model ReviewReply {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([userId])
  @@map("review_replies")
}

model RackItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("rack_items")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  imageUrl  String   @map("image_url")
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model TryOnResult {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  productId        String?         @map("product_id") @db.Uuid
  humanImageHash   String          @map("human_image_hash")
  garmentImageHash String          @map("garment_image_hash")
  category         GarmentCategory @default(UPPER)
  garments         Json?           @map("garments")
  resultUrl        String          @map("result_url")
  cacheKey         String?         @map("cache_key")
  expiresAt        DateTime?       @map("expires_at")
  providerMetadata Json?           @map("provider_metadata")
  createdAt        DateTime        @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([humanImageHash, garmentImageHash])
  @@index([cacheKey])
  @@index([expiresAt])
  @@map("try_on_results")
}

model StylistResult {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  productId           String?   @map("product_id") @db.Uuid
  humanImageUrl       String    @map("human_image_url")
  humanImageHash      String?   @map("human_image_hash")
  garmentDescription  String?   @map("garment_description")
  occasion            String?
  stylePreference     String?   @map("style_preference")
  genderPreference    String?   @map("gender_preference")
  budget              String?   @map("budget")
  fitAdvice           String?   @map("fit_advice")
  model               String?   @map("model")
  analysisResult      Json      @map("analysis_result")
  inputContext        Json?     @map("input_context")
  rawProviderResponse Json?     @map("raw_provider_response")
  cacheKey            String?   @map("cache_key")
  expiresAt           DateTime? @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([humanImageHash])
  @@index([cacheKey])
  @@index([expiresAt])
  @@map("stylist_results")
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  orderCode         Int         @unique @map("order_code")
  userId            String      @map("user_id") @db.Uuid
  targetTier        UserTier?   @map("target_tier")
  amount            Decimal     @db.Decimal(10, 2)
  status            OrderStatus @default(PENDING)
  shippingInfo      Json?       @map("shipping_info")
  paymentMethod     String?     @map("payment_method")
  paymentProvider   String?     @map("payment_provider")
  checkoutUrl       String?     @map("checkout_url")
  checkoutExpiresAt DateTime?   @map("checkout_expires_at")
  shippingFee       Decimal?    @map("shipping_fee") @db.Decimal(10, 2)
  discountAmount    Decimal?    @map("discount_amount") @db.Decimal(10, 2)
  couponCode        String?     @map("coupon_code")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      Payment[]
  items         OrderItem[]
  subscriptions Subscription[]
  reviews       Review[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  quantity            Int      @default(1)
  color               String?
  measurementSnapshot Json?    @map("measurement_snapshot")
  price               Decimal  @db.Decimal(10, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  provider      String   @default("SEPAY")
  transactionId String?  @map("transaction_id")
  paymentData   Json?    @map("payment_data")
  createdAt     DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, transactionId])
  @@map("payments")
}

model DailyUsage {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  action    AiActionType
  date      String // Format: YYYY-MM-DD
  count     Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action, date])
  @@map("daily_usages")
}

model ChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  role      String // "user" | "assistant" | "system"
  content   String   @db.Text
  tokensIn  Int?     @map("tokens_in")
  tokensOut Int?     @map("tokens_out")
  model     String?
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  message   String           @db.Text
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum SubscriptionStatus {
  ACTIVE
  SCHEDULED
  EXPIRED
  CANCELLED
}

model Subscription {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  tier                  UserTier
  orderId               String             @map("order_id") @db.Uuid
  status                SubscriptionStatus @default(ACTIVE)
  autoRenew             Boolean            @default(true) @map("auto_renew")
  startsAt              DateTime           @map("starts_at")
  expiresAt             DateTime           @map("expires_at")
  renewalReminderSentAt DateTime?          @map("renewal_reminder_sent_at")
  createdAt             DateTime           @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([status, startsAt])
  @@map("subscriptions")
}
