datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  // Alpine không có binary `openssl` nên Prisma tự đoán sai thành openssl-1.1.x và
  // sinh engine link tới libssl.so.1.1 (không tồn tại trong image). Khai báo tay
  // để engine luôn khớp libssl.so.3.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum UserTier {
  FREE
  MEMBER
  VIP
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum GarmentCategory {
  UPPER
  LOWER
  FULL_BODY
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
  RETURNED
  EXPIRED
  FAILED
}

enum AiActionType {
  TRY_ON
  STYLIST
  CHATBOT
}

enum NotificationType {
  ORDER_STATUS
  PAYMENT
  PROMOTION
  SYSTEM
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique
  passwordHash    String?      @map("password_hash")
  name            String?
  avatarUrl       String?      @map("avatar_url")
  provider        AuthProvider @default(LOCAL)
  providerId      String?      @map("provider_id")
  tier            UserTier     @default(FREE)
  tierExpiresAt   DateTime?    @map("tier_expires_at")
  role            Role         @default(USER)
  isVerified      Boolean      @default(false) @map("is_verified")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  measurements             Measurement?
  avatars                  Avatar[]
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  tryOnResults             TryOnResult[]
  stylistResults           StylistResult[]
  orders                   Order[]
  dailyUsages              DailyUsage[]
  chatSessions             ChatSession[]
  notifications            Notification[]
  subscriptions            Subscription[]

  @@map("users")
}

model Measurement {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  height       Decimal? @db.Decimal(5, 1)
  weight       Decimal? @db.Decimal(5, 1)
  chest        Decimal? @db.Decimal(5, 1)
  waist        Decimal? @db.Decimal(5, 1)
  hip          Decimal? @db.Decimal(5, 1)
  shoulder     Decimal? @db.Decimal(5, 1)
  neck         Decimal? @db.Decimal(5, 1)
  sleeveLength Decimal? @db.Decimal(5, 1) @map("sleeve_length")
  wrist        Decimal? @db.Decimal(5, 1)
  thigh        Decimal? @db.Decimal(5, 1)
  knee         Decimal? @db.Decimal(5, 1)
  calf         Decimal? @db.Decimal(5, 1)
  inseam       Decimal? @db.Decimal(5, 1)
  outseam      Decimal? @db.Decimal(5, 1)
  shirtLength  Decimal? @db.Decimal(5, 1) @map("shirt_length")
  underbust    Decimal? @db.Decimal(5, 1)
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("measurements")
}

model Avatar {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  gender    String   @default("female") // "male" | "female"
  height    Decimal? @db.Decimal(5, 1)
  weight    Decimal? @db.Decimal(5, 1)
  chest     Decimal? @db.Decimal(5, 1)
  waist     Decimal? @db.Decimal(5, 1)
  hip       Decimal? @db.Decimal(5, 1)
  shoulder  Decimal? @db.Decimal(5, 1)
  glbUrl    String   @map("glb_url")
  cacheKey  String   @map("cache_key")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cacheKey])
  @@index([userId])
  @@map("avatars")
}

// Lưới GLB preset sinh offline (gender x height x weight) - dùng cho FE không cần
// chạy Blender. presetMeasurements là số đo mặc định đã nướng vào GLB; FE dùng
// morph targets để chỉnh theo số đo thật của user.
model AvatarPreset {
  id                 String   @id @default(uuid()) @db.Uuid
  gender             String // "male" | "female"
  height             Decimal  @db.Decimal(5, 1) // cm
  weight             Decimal  @db.Decimal(5, 1) // kg
  glbUrl             String   @map("glb_url")
  presetMeasurements Json     @map("preset_measurements") // { chest, waist, hip, shoulder }
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([gender, height, weight])
  @@index([gender])
  @@map("avatar_presets")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Product {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  description   String?         @db.Text
  category      GarmentCategory @default(UPPER)
  color         String?
  price         Decimal         @db.Decimal(10, 2)
  originalPrice Decimal?        @db.Decimal(10, 2) @map("original_price")
  stock         Int             @default(0)
  brand         String?         @default("StAle. SIGNATURE")
  garmentUrl    String          @map("garment_url")
  status        ProductStatus   @default(ACTIVE)
  colors        Json?           // [{ name: string, hex: string }]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  images        ProductImage[]
  tryOnResults  TryOnResult[]
  stylistResults StylistResult[]
  orderItems    OrderItem[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  imageUrl  String   @map("image_url")
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model TryOnResult {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  productId        String?         @map("product_id") @db.Uuid
  humanImageHash   String          @map("human_image_hash")
  garmentImageHash String          @map("garment_image_hash")
  category         GarmentCategory @default(UPPER)
  garments         Json?           @map("garments")
  resultUrl        String          @map("result_url")
  cacheKey         String?         @map("cache_key")
  expiresAt        DateTime?       @map("expires_at")
  providerMetadata Json?           @map("provider_metadata")
  createdAt        DateTime        @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([humanImageHash, garmentImageHash])
  @@index([cacheKey])
  @@index([expiresAt])
  @@map("try_on_results")
}

model StylistResult {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  productId          String?  @map("product_id") @db.Uuid
  humanImageUrl      String   @map("human_image_url")
  humanImageHash     String?  @map("human_image_hash")
  garmentDescription String?  @map("garment_description")
  occasion           String?
  stylePreference    String?  @map("style_preference")
  genderPreference   String?  @map("gender_preference")
  budget             String?  @map("budget")
  fitAdvice          String?  @map("fit_advice")
  model              String?  @map("model")
  analysisResult     Json     @map("analysis_result")
  inputContext       Json?    @map("input_context")
  rawProviderResponse Json?   @map("raw_provider_response")
  cacheKey           String?  @map("cache_key")
  expiresAt          DateTime? @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([humanImageHash])
  @@index([cacheKey])
  @@index([expiresAt])
  @@map("stylist_results")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  orderCode     Int         @unique @map("order_code")
  userId        String      @map("user_id") @db.Uuid
  targetTier    UserTier?   @map("target_tier")
  amount        Decimal     @db.Decimal(10, 2)
  status        OrderStatus @default(PENDING)
  shippingInfo  Json?       @map("shipping_info")
  paymentMethod String?     @map("payment_method")
  paymentProvider String?   @map("payment_provider")
  checkoutUrl   String?     @map("checkout_url")
  checkoutExpiresAt DateTime? @map("checkout_expires_at")
  shippingFee   Decimal?    @db.Decimal(10, 2) @map("shipping_fee")
  discountAmount Decimal?   @db.Decimal(10, 2) @map("discount_amount")
  couponCode    String?     @map("coupon_code")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      Payment[]
  items         OrderItem[]
  subscriptions Subscription[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(1)
  color     String?
  measurementSnapshot Json? @map("measurement_snapshot")
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  provider      String   @default("SEPAY")
  transactionId String?  @map("transaction_id")
  paymentData   Json?    @map("payment_data")
  createdAt     DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, transactionId])
  @@map("payments")
}

model DailyUsage {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  action    AiActionType
  date      String       // Format: YYYY-MM-DD
  count     Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action, date])
  @@map("daily_usages")
}

model ChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  role      String   // "user" | "assistant" | "system"
  content   String   @db.Text
  tokensIn  Int?     @map("tokens_in")
  tokensOut Int?     @map("tokens_out")
  model     String?
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  message   String           @db.Text
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  tier      UserTier
  orderId   String               @map("order_id") @db.Uuid
  status    SubscriptionStatus   @default(ACTIVE)
  startsAt  DateTime             @map("starts_at")
  expiresAt DateTime             @map("expires_at")
  createdAt DateTime             @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([userId, status])
  @@map("subscriptions")
}
