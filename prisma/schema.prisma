datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  // Alpine không có binary `openssl` nên Prisma tự đoán sai thành openssl-1.1.x và
  // sinh engine link tới libssl.so.1.1 (không tồn tại trong image). Khai báo tay
  // để engine luôn khớp libssl.so.3.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum UserTier {
  FREE
  MEMBER
  VIP
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum GarmentCategory {
  UPPER
  LOWER
  FULL_BODY
}

enum GarmentType {
  SHIRT
  VEST
  JACKET
  PANTS
  SKIRT
  DRESS
  JUMPSUIT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING
  PAID
  CONFIRMED
  MEASUREMENT_REVIEW
  MEASUREMENT_CONFIRMED
  TAILORING
  QUALITY_CHECK
  PROCESSING
  READY_TO_SHIP
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURNING
  RETURNED
  EXPIRED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_REQUIRED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
  COD_COLLECTED
}

enum RefundStatus {
  NONE
  PENDING
  REQUIRED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  READY_TO_PICK
  CREATED
  PICKING
  PICKED
  SHIPPING
  IN_TRANSIT
  DELIVERING
  DELIVERED
  DELIVERY_FAILED
  RETURNING
  RETURNED
  CANCELLED
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED_RETRYABLE
  FAILED_DEAD
  IGNORED_DUPLICATE
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED_RETRYABLE
  FAILED_DEAD
}

enum AiActionType {
  TRY_ON
  STYLIST
  CHATBOT
}

enum NotificationType {
  ORDER_STATUS
  PAYMENT
  PROMOTION
  SYSTEM
  REVIEW
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique
  passwordHash  String?      @map("password_hash")
  name          String?
  avatarUrl     String?      @map("avatar_url")
  provider      AuthProvider @default(LOCAL)
  providerId    String?      @map("provider_id")
  tier          UserTier     @default(FREE)
  tierExpiresAt DateTime?    @map("tier_expires_at")
  role          Role         @default(USER)
  isVerified    Boolean      @default(false) @map("is_verified")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  measurements            Measurement?
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  tryOnResults            TryOnResult[]
  stylistResults          StylistResult[]
  orders                  Order[]
  dailyUsages             DailyUsage[]
  chatSessions            ChatSession[]
  notifications           Notification[]
  subscriptions           Subscription[]
  rackItems               RackItem[]
  reviews                 Review[]
  reviewReplies           ReviewReply[]

  @@map("users")
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Measurement {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  height       Decimal? @db.Decimal(5, 1)
  weight       Decimal? @db.Decimal(5, 1)
  chest        Decimal? @db.Decimal(5, 1)
  waist        Decimal? @db.Decimal(5, 1)
  hip          Decimal? @db.Decimal(5, 1)
  shoulder     Decimal? @db.Decimal(5, 1)
  neck         Decimal? @db.Decimal(5, 1)
  sleeveLength Decimal? @map("sleeve_length") @db.Decimal(5, 1)
  wrist        Decimal? @db.Decimal(5, 1)
  thigh        Decimal? @db.Decimal(5, 1)
  knee         Decimal? @db.Decimal(5, 1)
  calf         Decimal? @db.Decimal(5, 1)
  inseam       Decimal? @db.Decimal(5, 1)
  outseam      Decimal? @db.Decimal(5, 1)
  shirtLength  Decimal? @map("shirt_length") @db.Decimal(5, 1)
  underbust    Decimal? @db.Decimal(5, 1)
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("measurements")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Product {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  description   String?         @db.Text
  category      GarmentCategory @default(UPPER)
  garmentType   GarmentType?    @map("garment_type")
  color         String?
  price         Decimal         @db.Decimal(10, 2)
  originalPrice Decimal?        @map("original_price") @db.Decimal(10, 2)
  stock         Int             @default(0)
  brand         String?         @default("StAle. SIGNATURE")
  garmentUrl    String          @map("garment_url")
  status        ProductStatus   @default(ACTIVE)
  colors        Json? // [{ name: string, hex: string }]
  material      String?
  avgRating     Decimal?        @default(0) @db.Decimal(2, 1) @map("avg_rating")
  reviewCount   Int             @default(0) @map("review_count")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  images         ProductImage[]
  tryOnResults   TryOnResult[]
  stylistResults StylistResult[]
  orderItems     OrderItem[]
  rackItems      RackItem[]
  reviews        Review[]
  collections    ProductCollection[]

  @@map("products")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  rating    Int
  comment   String?  @db.Text
  images    Json?    // [{ url: string }]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  replies ReviewReply[]

  @@unique([userId, productId, orderId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model ReviewReply {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([userId])
  @@map("review_replies")
}

model RackItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("rack_items")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  imageUrl  String   @map("image_url")
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model TryOnResult {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  productId        String?         @map("product_id") @db.Uuid
  humanImageHash   String          @map("human_image_hash")
  garmentImageHash String          @map("garment_image_hash")
  category         GarmentCategory @default(UPPER)
  garments         Json?           @map("garments")
  resultUrl        String          @map("result_url")
  cacheKey         String?         @map("cache_key")
  expiresAt        DateTime?       @map("expires_at")
  providerMetadata Json?           @map("provider_metadata")
  createdAt        DateTime        @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([humanImageHash, garmentImageHash])
  @@index([cacheKey])
  @@index([expiresAt])
  @@map("try_on_results")
}

model StylistResult {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  productId           String?   @map("product_id") @db.Uuid
  humanImageUrl       String    @map("human_image_url")
  humanImageHash      String?   @map("human_image_hash")
  garmentDescription  String?   @map("garment_description")
  occasion            String?
  stylePreference     String?   @map("style_preference")
  genderPreference    String?   @map("gender_preference")
  budget              String?   @map("budget")
  fitAdvice           String?   @map("fit_advice")
  model               String?   @map("model")
  analysisResult      Json      @map("analysis_result")
  inputContext        Json?     @map("input_context")
  rawProviderResponse Json?     @map("raw_provider_response")
  cacheKey            String?   @map("cache_key")
  expiresAt           DateTime? @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([humanImageHash])
  @@index([cacheKey])
  @@index([expiresAt])
  @@map("stylist_results")
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  orderCode         Int         @unique @map("order_code")
  userId            String      @map("user_id") @db.Uuid
  targetTier        UserTier?   @map("target_tier")
  amount            Decimal     @db.Decimal(10, 2)
  itemsSubtotalVnd  BigInt?     @map("items_subtotal_vnd")
  shippingFeeVnd    BigInt?     @map("shipping_fee_vnd")
  discountVnd       BigInt?     @map("discount_vnd")
  taxVnd            BigInt?     @default(0) @map("tax_vnd")
  totalVnd          BigInt?     @map("total_vnd")
  amountPaidVnd     BigInt      @default(0) @map("amount_paid_vnd")
  amountRefundedVnd BigInt      @default(0) @map("amount_refunded_vnd")
  currency          String      @default("VND")
  status            OrderStatus @default(PENDING)
  shippingInfo      Json?       @map("shipping_info")
  shippingAddressSnapshot Json?  @map("shipping_address_snapshot")
  shippingQuoteSnapshot   Json?  @map("shipping_quote_snapshot")
  paymentMethod     String?     @map("payment_method")
  paymentProvider   String?     @map("payment_provider")
  checkoutUrl       String?     @map("checkout_url")
  checkoutExpiresAt DateTime?   @map("checkout_expires_at")
  shippingFee       Decimal?    @map("shipping_fee") @db.Decimal(10, 2)
  discountAmount    Decimal?    @map("discount_amount") @db.Decimal(10, 2)
  couponCode        String?     @map("coupon_code")
  fulfillmentFlowVersion Int?    @map("fulfillment_flow_version")
  paymentStatus     PaymentStatus? @map("payment_status")
  refundStatus      RefundStatus @default(NONE) @map("refund_status")
  refundEvidence    Json?       @map("refund_evidence")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      Payment[]
  refunds       Refund[]
  items         OrderItem[]
  subscriptions Subscription[]
  reviews       Review[]
  shipments     Shipment[]
  events        OrderEvent[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([checkoutExpiresAt])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  quantity            Int      @default(1)
  color               String?
  measurementSnapshot Json?    @map("measurement_snapshot")
  productNameSnapshot String?  @map("product_name_snapshot")
  productSkuSnapshot  String?  @map("product_sku_snapshot")
  productImageSnapshot String? @map("product_image_snapshot")
  productCategorySnapshot String? @map("product_category_snapshot")
  brandSnapshot       String?  @map("brand_snapshot")
  fabricSnapshot      String?  @map("fabric_snapshot")
  measurementReview   Json?    @map("measurement_review")
  price               Decimal  @db.Decimal(10, 2)
  unitPriceVnd        BigInt?  @map("unit_price_vnd")
  lineTotalVnd        BigInt?  @map("line_total_vnd")
  createdAt           DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Shipment {
  id                   String         @id @default(uuid()) @db.Uuid
  orderId              String         @map("order_id") @db.Uuid
  provider             String         @default("GHN")
  providerOrderCode    String?        @map("provider_order_code")
  requestKey           String         @unique @map("request_key")
  status               ShipmentStatus @default(PENDING)
  rawStatus            String?        @map("raw_status")
  shippingFee          Decimal?       @map("shipping_fee") @db.Decimal(10, 2)
  shippingFeeVnd       BigInt?        @map("shipping_fee_vnd")
  quotedShippingFee    Decimal?       @map("quoted_shipping_fee") @db.Decimal(10, 2)
  actualShippingFee    Decimal?       @map("actual_shipping_fee") @db.Decimal(10, 2)
  expectedDeliveryTime DateTime?      @map("expected_delivery_time")
  trackingUrl          String?        @map("tracking_url")
  trackingData         Json?          @map("tracking_data")
  providerEventAt      DateTime?      @map("provider_event_at")
  lastSyncedAt         DateTime?      @map("last_synced_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  order  Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events OrderEvent[]

  @@unique([provider, providerOrderCode])
  @@index([orderId])
  @@index([orderId, status])
  @@index([provider, status])
  @@index([status, createdAt])
  @@index([providerOrderCode])
  @@index([lastSyncedAt])
  @@index([expectedDeliveryTime])
  @@index([rawStatus, createdAt])
  @@map("shipments")
}

model WebhookEvent {
  id                String             @id @default(uuid()) @db.Uuid
  provider          String
  eventKey          String             @unique @map("event_key")
  providerEventId   String?            @map("provider_event_id")
  providerOrderCode String?            @map("provider_order_code")
  eventType         String?            @map("event_type")
  status            WebhookEventStatus @default(PROCESSED)
  payload           Json?
  signatureValid    Boolean?           @map("signature_valid")
  orderId           String?            @map("order_id") @db.Uuid
  paymentId         String?            @map("payment_id") @db.Uuid
  shipmentId        String?            @map("shipment_id") @db.Uuid
  receivedAt        DateTime           @default(now()) @map("received_at")
  processedAt       DateTime?          @default(now()) @map("processed_at")
  attemptCount      Int                @default(0) @map("attempt_count")
  lastError         String?            @map("last_error") @db.Text

  @@unique([provider, providerEventId])
  @@index([provider, providerOrderCode])
  @@index([provider, eventType, receivedAt])
  @@index([orderId])
  @@index([paymentId])
  @@index([shipmentId])
  @@map("webhook_events")
}

model OrderEvent {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  shipmentId       String?      @map("shipment_id") @db.Uuid
  type             String
  fromStatus       OrderStatus? @map("from_status")
  toStatus         OrderStatus? @map("to_status")
  fromPaymentStatus PaymentStatus? @map("from_payment_status")
  toPaymentStatus   PaymentStatus? @map("to_payment_status")
  fromShipmentStatus ShipmentStatus? @map("from_shipment_status")
  toShipmentStatus   ShipmentStatus? @map("to_shipment_status")
  source           String
  actorId          String?      @map("actor_id") @db.Uuid
  occurredAt       DateTime     @default(now()) @map("occurred_at")
  recordedAt       DateTime     @default(now()) @map("recorded_at")
  deduplicationKey String?      @unique @map("deduplication_key")
  publicMessage    String?      @map("public_message") @db.Text
  internalNote     String?      @map("internal_note") @db.Text
  metadata         Json?

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([orderId, occurredAt])
  @@map("order_events")
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  orderId            String        @map("order_id") @db.Uuid
  method             String?       @map("method")
  provider           String        @default("SEPAY")
  transactionId      String?       @map("transaction_id")
  providerPaymentId  String?       @map("provider_payment_id")
  status             PaymentStatus @default(PENDING)
  amountVnd          BigInt?       @map("amount_vnd")
  currency           String        @default("VND")
  paidAt             DateTime?     @map("paid_at")
  failedAt           DateTime?     @map("failed_at")
  refundedAt         DateTime?     @map("refunded_at")
  failureReason      String?       @map("failure_reason") @db.Text
  idempotencyKey     String?       @unique @map("idempotency_key")
  paymentData        Json?         @map("payment_data")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([provider, transactionId])
  @@unique([provider, providerPaymentId])
  @@index([orderId, status])
  @@index([orderId, createdAt])
  @@index([provider, createdAt])
  @@map("payments")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  paymentId        String?      @map("payment_id") @db.Uuid
  provider         String       @default("MANUAL")
  providerRefundId String?      @map("provider_refund_id")
  amountVnd        BigInt       @map("amount_vnd")
  currency         String       @default("VND")
  reason           String?      @db.Text
  status           RefundStatus @default(PENDING)
  idempotencyKey   String?      @unique @map("idempotency_key")
  requestedAt      DateTime     @default(now()) @map("requested_at")
  processedAt      DateTime?    @map("processed_at")
  failedReason     String?      @map("failed_reason") @db.Text
  metadata         Json?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerRefundId])
  @@index([orderId, status])
  @@index([paymentId])
  @@map("refunds")
}

model OutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  eventKey      String            @unique @map("event_key")
  type          String
  aggregateType String            @map("aggregate_type")
  aggregateId   String            @map("aggregate_id")
  payload       Json?
  status        OutboxEventStatus @default(PENDING)
  attemptCount  Int               @default(0) @map("attempt_count")
  nextRunAt     DateTime?         @map("next_run_at")
  lastError     String?           @map("last_error") @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  processedAt   DateTime?         @map("processed_at")

  @@index([status, nextRunAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model WebhookFailure {
  id         String    @id @default(uuid()) @db.Uuid
  provider   String
  reason     String
  message    String    @db.Text
  rawPayload Json      @map("raw_payload")
  orderCode  Int?      @map("order_code")
  resolved   Boolean   @default(false)
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([resolved, createdAt])
  @@map("webhook_failures")
}

model DailyUsage {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  action    AiActionType
  date      String // Format: YYYY-MM-DD
  count     Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action, date])
  @@map("daily_usages")
}

model ChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  role      String // "user" | "assistant" | "system"
  content   String   @db.Text
  tokensIn  Int?     @map("tokens_in")
  tokensOut Int?     @map("tokens_out")
  model     String?
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  message   String           @db.Text
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum SubscriptionStatus {
  ACTIVE
  SCHEDULED
  EXPIRED
  CANCELLED
}

model Subscription {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  tier                  UserTier
  orderId               String             @map("order_id") @db.Uuid
  status                SubscriptionStatus @default(ACTIVE)
  autoRenew             Boolean            @default(true) @map("auto_renew")
  startsAt              DateTime           @map("starts_at")
  expiresAt             DateTime           @map("expires_at")
  renewalReminderSentAt DateTime?          @map("renewal_reminder_sent_at")
  createdAt             DateTime           @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([status, startsAt])
  @@map("subscriptions")
}

model Collection {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  slug          String   @unique
  description   String?  @db.Text
  coverImages   String[] // Array of Cloudinary URLs (3 items for hero banner)
  isPublished   Boolean  @default(false) @map("is_published")
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  products ProductCollection[]

  @@index([isPublished])
  @@index([displayOrder])
  @@map("collections")
}

model ProductCollection {
  collectionId String @map("collection_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("product_collections")
}
